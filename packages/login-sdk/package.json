{
  "name": "@curso/login-sdk",
  "version": "0.1.0",
  "description": "SDK de login com SQLite local. Cadastro, sessão e senha com hash.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx",
      "default": "./src/react.tsx"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "src",
    "sql"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "db:create": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT"
}
